{
  "name": "city-guardian-image-analyzer",
  "version": "1.0.0",
  "description": "AI-based image analyzer for City Guardian to categorize citizen-uploaded problem images",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "nodemon api/index.js",
    "train": "node scripts/train-model.js",
    "test": "node scripts/test-model.js",
    "start:all": "./start.sh",
    "stop": "./stop-servers.sh",
    "test:system": "./test-system.sh",
    "test:connection": "./test-frontend-connection.sh"
  },
  "keywords": [
    "image-classification",
    "tensorflow",
    "city-guardian",
    "ai",
    "pollution-detection"
  ],
  "author": "City Guardian Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs-node": "^4.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "jimp": "^0.22.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
